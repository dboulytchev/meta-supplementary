{a = [2, 3, 1, 20, 50];
   i = 1;
     while (i < a.length - 1)
       {if (a [i] > a [i + 1]) {
           a = [a with i = a [i + 1], i + 1 = a [i]]
	}
        else {skip}
        i = i + 1
     }
     
   i = 0;
     while (i < a.length - 1)
       {if (a [i] > a [i + 1]) {a = [a with i = a [i + 1], i + 1 = a [i]]}
          else {skip}
          i = i + 1}
	  
	  cont = 0;
	  
     while (cont)
       {i = 0;
          while (i < a.length - 1)
            {if (a [i] > a [i + 1])
               {a = [a with i = a [i + 1], i + 1 = a [i]]} else {skip}
               i = i + 1}}
   }
